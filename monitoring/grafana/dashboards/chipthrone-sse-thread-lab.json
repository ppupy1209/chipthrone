      "type": "timeseries", "title": "프로세스 CPU", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process CPU", "refId": "A" }
      ]
